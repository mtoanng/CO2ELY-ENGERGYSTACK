      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#059669",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
