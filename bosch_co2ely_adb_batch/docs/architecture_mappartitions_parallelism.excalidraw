    },
    {
      "id": "pbxvx5evaGFXmIfZlrxkH",
      "type": "text",
      "x": 1381.9006396513437,
      "y": -650.8642061308844,
      "width": 585.2000122070312,
      "height": 100,
      "text": "1. IncrementalTracker.get_new_files() → 48 BlobInfo (SDK listing + watermark)\n2. Filter by extension (.xlsx/.csv) + skip exhausted retries\n3. spark.createDataFrame(48 rows) → each Row = file processing args\n4. .repartition(ceil(48/8) = 6) → 6 partitions = 6 tasks\n5. .rdd.mapPartitions(_process_partition) → distribute to workers",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 1365238719,
      "version": 156,
      "versionNonce": 517977873,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781765707985,
      "link": null,
      "locked": false,
      "index": "b0E",
      "strokeStyle": "solid",
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. IncrementalTracker.get_new_files() → 48 BlobInfo (SDK listing + watermark)\n2. Filter by extension (.xlsx/.csv) + skip exhausted retries\n3. spark.createDataFrame(48 rows) → each Row = file processing args\n4. .repartition(ceil(48/8) = 6) → 6 partitions = 6 tasks\n5. .rdd.mapPartitions(_process_partition) → distribute to workers",
      "autoResize": true,
      "lineHeight": 1.5384615384615385
    },
    {
      "id": "QFzvpusJuQ9lrqoRJN2Mf",
      "type": "text",
      "x": 2001.9006396513437,
      "y": -650.8642061308844,
      "width": 400,
      "height": 120,
      "text": "┌─────────────────────────────────────┐\n│  KEY FORMULAS:                      │\n│                                     │\n│  tasks = ceil(N_files / FPP)        │\n│  slots/worker = cores / task.cpus   │\n│  concurrent = tasks × THREADS       │\n│  autoscale if tasks > slots         │\n└─────────────────────────────────────┘",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#9333ea",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 541791199,
      "version": 121,
      "versionNonce": 157793919,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781765707985,
      "link": null,
      "locked": false,
      "index": "b0F",
      "strokeStyle": "solid",
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────────────────────────────────────┐\n│  KEY FORMULAS:                      │\n│                                     │\n│  tasks = ceil(N_files / FPP)        │\n│  slots/worker = cores / task.cpus   │\n│  concurrent = tasks × THREADS       │\n│  autoscale if tasks > slots         │\n└─────────────────────────────────────┘",
      "autoResize": true,
      "lineHeight": 1.1538461538461537
    },
