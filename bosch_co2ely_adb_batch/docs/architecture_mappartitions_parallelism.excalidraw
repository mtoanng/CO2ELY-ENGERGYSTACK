    },
    {
      "id": "ROYt04bNxobFNC3zHuuSj",
      "type": "text",
      "x": 1371.9006396513437,
      "y": -300.86420613088455,
      "width": 411.20001220703125,
      "height": 320,
      "text": "┌─ Task 0 (4 cores) ── Partition 0: [file_0..file_7] ─────────┐\n│  BlobServiceClient (1 per task, shared across threads)      │\n│  ParquetWriter (1 per task)                                 │\n│                                                             │\n│  ThreadPoolExecutor(max_workers=2):                         │\n│  ┌──────────────────┐  ┌──────────────────┐                 │\n│  │ Thread A (2cores)│  │ Thread B (2cores)│                 │\n│  │ file_0: download │  │ file_1: download │  ← Round 1      │\n│  │   → parse(Polars)│  │   → parse(Polars)│                 │\n│  │   → write(SDK)   │  │   → write(SDK)   │                 │\n│  │ file_2: ...      │  │ file_3: ...      │  ← Round 2      │\n│  │ file_4: ...      │  │ file_5: ...      │  ← Round 3      │\n│  │ file_6: ...      │  │ file_7: ...      │  ← Round 4      │\n│  └──────────────────┘  └──────────────────┘                 │\n└─────────────────────────────────────────────────────────────┘\n┌─ Task 1 (4 cores) ── Partition 1: [file_8..file_15] ─────────┐\n│  (same structure as Task 0)                                  │\n└──────────────────────────────────────────────────────────────┘\n┌─ Task 2 (4 cores) ── Partition 2: [file_16..file_23] ────────┐\n│  (same structure)                                            │\n└──────────────────────────────────────────────────────────────┘\n┌─ Task 3 (4 cores) ── Partition 3: [file_24..file_31] ────────┐\n│  (same structure)                                            │\n└──────────────────────────────────────────────────────────────┘",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 922247327,
      "version": 139,
      "versionNonce": 1744299729,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781765707985,
      "link": null,
      "locked": false,
      "index": "b0L",
      "strokeStyle": "solid",
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─ Task 0 (4 cores) ── Partition 0: [file_0..file_7] ─────────┐\n│  BlobServiceClient (1 per task, shared across threads)      │\n│  ParquetWriter (1 per task)                                 │\n│                                                             │\n│  ThreadPoolExecutor(max_workers=2):                         │\n│  ┌──────────────────┐  ┌──────────────────┐                 │\n│  │ Thread A (2cores)│  │ Thread B (2cores)│                 │\n│  │ file_0: download │  │ file_1: download │  ← Round 1      │\n│  │   → parse(Polars)│  │   → parse(Polars)│                 │\n│  │   → write(SDK)   │  │   → write(SDK)   │                 │\n│  │ file_2: ...      │  │ file_3: ...      │  ← Round 2      │\n│  │ file_4: ...      │  │ file_5: ...      │  ← Round 3      │\n│  │ file_6: ...      │  │ file_7: ...      │  ← Round 4      │\n│  └──────────────────┘  └──────────────────┘                 │\n└─────────────────────────────────────────────────────────────┘\n┌─ Task 1 (4 cores) ── Partition 1: [file_8..file_15] ─────────┐\n│  (same structure as Task 0)                                  │\n└──────────────────────────────────────────────────────────────┘\n┌─ Task 2 (4 cores) ── Partition 2: [file_16..file_23] ────────┐\n│  (same structure)                                            │\n└──────────────────────────────────────────────────────────────┘\n┌─ Task 3 (4 cores) ── Partition 3: [file_24..file_31] ────────┐\n│  (same structure)                                            │\n└──────────────────────────────────────────────────────────────┘",
      "autoResize": true,
      "lineHeight": 1.2121212121212122
    },
