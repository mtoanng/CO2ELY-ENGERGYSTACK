    {
      "id": "OvQVwIwwkT6ZxWfyjoe4F",
      "type": "text",
      "x": 1371.9006396513437,
      "y": -450.86420613088444,
      "width": 1050,
      "height": 60,
      "text": "SPARK SCHEDULER — assigns tasks to available slots (16 cores ÷ 4 spark.task.cpus = 4 slots/worker)\n\n6 tasks total → Worker 1 gets Task 0,1,2,3 (4 slots full) → Task 4,5 PENDING → autoscale trigger → Worker 2 starts",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#92400e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 1297910847,
      "version": 121,
      "versionNonce": 1893248241,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781765707985,
      "link": null,
      "locked": false,
      "index": "b0I",
      "strokeStyle": "solid",
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SPARK SCHEDULER — assigns tasks to available slots (16 cores ÷ 4 spark.task.cpus = 4 slots/worker)\n\n6 tasks total → Worker 1 gets Task 0,1,2,3 (4 slots full) → Task 4,5 PENDING → autoscale trigger → Worker 2 starts",
      "autoResize": true,
      "lineHeight": 1.5384615384615385
    },
