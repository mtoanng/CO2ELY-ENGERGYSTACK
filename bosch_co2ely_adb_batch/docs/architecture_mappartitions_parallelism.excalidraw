    {
      "id": "8KBqkQRweisW3_tyvuzmo",
      "type": "text",
      "x": 1371.9006396513437,
      "y": 79.13579386911556,
      "width": 1050,
      "height": 100,
      "text": "COLLECT RESULTS → DRIVER\n\n48 Result Rows (blob_path, status, output_paths, duration_seconds) ← shuffle back from workers\n→ tracker.batch_merge_results(results_df) → MERGE INTO tracking_table (atomic, idempotent)\n→ Log summary: SUCCESS/FAILED counts, failed file paths",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#991b1b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 1777147199,
      "version": 121,
      "versionNonce": 551402207,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781765707985,
      "link": null,
      "locked": false,
      "index": "b0Q",
      "strokeStyle": "solid",
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "COLLECT RESULTS → DRIVER\n\n48 Result Rows (blob_path, status, output_paths, duration_seconds) ← shuffle back from workers\n→ tracker.batch_merge_results(results_df) → MERGE INTO tracking_table (atomic, idempotent)\n→ Log summary: SUCCESS/FAILED counts, failed file paths",
      "autoResize": true,
      "lineHeight": 1.5384615384615385
    },
