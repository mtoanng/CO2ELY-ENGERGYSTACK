      "updated": 1783157707278,
      "link": null,
      "locked": false,
      "text": "silver_dim_experiment\n- experiment_id = xxhash64(uuid, group)\n- uuid, group, series\n\nsilver_dim_signal\n- signal_id = xxhash64(uuid, group,\nchannel_id)\n- experiment_id, channel_id\n- raw_channel, std_channel, unit\n- column_index, series\n\nDQ tables\n- silver_dim_dq_rule\n- silver_fact_timeseries_dq_result\n- silver_fact_timeseries_dq_summary\n\nConstraint\n- one signal_id per experiment_id +\nstd_channel",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "silver_dim_experiment\n- experiment_id = xxhash64(uuid, group)\n- uuid, group, series\n\nsilver_dim_signal\n- signal_id = xxhash64(uuid, group, channel_id)\n- experiment_id, channel_id\n- raw_channel, std_channel, unit\n- column_index, series\n\nDQ tables\n- silver_dim_dq_rule\n- silver_fact_timeseries_dq_result\n- silver_fact_timeseries_dq_summary\n\nConstraint\n- one signal_id per experiment_id + std_channel",
      "lineHeight": 1.25,
      "index": "b3S",
      "autoResize": false
    },
