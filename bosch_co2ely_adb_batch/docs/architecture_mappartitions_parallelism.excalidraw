    {
      "id": "scheduler_text",
      "type": "text",
      "x": 70,
      "y": 340,
      "width": 1050,
      "height": 60,
      "text": "SPARK SCHEDULER — assigns tasks to available slots (16 cores ÷ 4 spark.task.cpus = 4 slots/worker)\n\n6 tasks total → Worker 1 gets Task 0,1,2,3 (4 slots full) → Task 4,5 PENDING → autoscale trigger → Worker 2 starts",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#92400e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
