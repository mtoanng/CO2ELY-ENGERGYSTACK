      "width": 1050,
      "height": 130,
      "text": "RESOURCE ALLOCATION SUMMARY (48 files, 2 workers)\n\n  Workers active:        2 (Worker 2 autoscaled because tasks > slots on Worker 1)\n  Task slots total:      8 (4 per worker × 2 workers)\n  Tasks:                 6 (ceil(48 / 8))\n  Files concurrent:      min(6, 8) × 2 = 12 files processing at any moment\n  Cores per file:        spark.task.cpus / THREADS = 4 / 2 = 2 cores ✓ (matches benchmark)\n  Memory per file:       ~7.3 GB peak (worst case 200MB xlsx with 3 sheets)\n  Est. total time:       4 rounds × 25s = ~100s (Worker 1) │ Worker 2 starts late at t=60, finishes at ~160s\n  Effective throughput:  48 files / 160s ≈ 0.3 files/sec",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#3730a3",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 491264383,
      "version": 121,
      "versionNonce": 823600785,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781765707985,
      "link": null,
      "locked": false,
      "index": "b0S",
      "strokeStyle": "solid",
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RESOURCE ALLOCATION SUMMARY (48 files, 2 workers)\n\n  Workers active:        2 (Worker 2 autoscaled because tasks > slots on Worker 1)\n  Task slots total:      8 (4 per worker × 2 workers)\n  Tasks:                 6 (ceil(48 / 8))\n  Files concurrent:      min(6, 8) × 2 = 12 files processing at any moment\n  Cores per file:        spark.task.cpus / THREADS = 4 / 2 = 2 cores ✓ (matches benchmark)\n  Memory per file:       ~7.3 GB peak (worst case 200MB xlsx with 3 sheets)\n  Est. total time:       4 rounds × 25s = ~100s (Worker 1) │ Worker 2 starts late at t=60, finishes at ~160s\n  Effective throughput:  48 files / 160s ≈ 0.3 files/sec",
      "autoResize": true,
      "lineHeight": 1.0833333333333333
    },
