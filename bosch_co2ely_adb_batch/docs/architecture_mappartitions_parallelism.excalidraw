    {
      "id": "K5WYV34CzJnVsMKb5_6jq",
      "type": "text",
      "x": 4937.017813937033,
      "y": 432.32665659522604,
      "width": 586.0672607421875,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
