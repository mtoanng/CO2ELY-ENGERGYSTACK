      "updated": 1783157707277,
      "link": null,
      "locked": false,
      "text": "1. Load and concatenate files/worksheets\npd.read_excel(sheet, header_row, skip rows before first_data_row).\nElapsed time stitching: continue as-is if next first_time ≈ previous max;\nif next first_time is 0/1, add previous max; otherwise mark unresolved offset.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Load and concatenate files/worksheets\npd.read_excel(sheet, header_row, skip rows before first_data_row).\nElapsed time stitching: continue as-is if next first_time ≈ previous max;\nif next first_time is 0/1, add previous max; otherwise mark unresolved offset.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b2q"
    },
