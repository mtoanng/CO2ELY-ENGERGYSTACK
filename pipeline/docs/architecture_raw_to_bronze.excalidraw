    {
      "id": "driver_text",
      "type": "text",
      "x": 340,
      "y": 108,
      "width": 280,
      "height": 125,
      "text": "SPARK DRIVER\n━━━━━━━━━━━━━━━━━━━━━━━━\n1. get_env_variables(spark)\n2. Azure SDK: list_blobs(raw_data/)\n3. IncrementalTracker: watermark query\n4. spark.createDataFrame(new_blobs)\n5. .repartition(defaultParallelism)\n6. .rdd.mapPartitions(→ workers)\n7. batch_merge_results(→ tracking)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
